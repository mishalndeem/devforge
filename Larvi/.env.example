# ---- LLM ----
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ---- Google OAuth (Gmail + Calendar) ----
# Create these at https://console.cloud.google.com  (enable Gmail API + Calendar API,
# create an OAuth 2.0 Client ID of type "Desktop app" or "Web application").
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Where OAuth tokens are cached after the user authorizes Larvi (per-user in production;
# a single file is fine for this internship project).
TOKEN_STORE_PATH=./data/token.json

# ---- App ----
# If true, Email/Calendar tools return realistic fake data instead of calling Google APIs.
# Useful for demoing the agent architecture before OAuth is wired up.
MOCK_MODE=true

# Session/context store (sqlite file). Keeps conversation state across turns.
STATE_DB_PATH=./data/larvi_state.db
